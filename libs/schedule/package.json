{
  "name": "@daffodil/schedule",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{workspaceRoot}/dist/schedule"
        ]
      }
    }
  },
  "version": "0.0.0-PLACEHOLDER",
  "description": "Utilities for generating Daffodil documentation pages. Part of the Daffodil ecommerce framework.",
  "repository": {
    "type": "git",
    "url": "https://github.com/graycoreio/daffodil"
  },
  "author": "Graycore LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/graycoreio/daffodil/issues"
  },
  "scripts": {
    "build": "ng build schedule --configuration production",
    "lint": "cd ../.. && ng lint schedule",
    "lint:fix": "npm run lint -- --fix",
    "test": "ng test schedule --watch=false --browsers=ChromeHeadless"
  },
  "peerDependencies": {
    "@angular/common": "0.0.0-PLACEHOLDER",
    "@angular/core": "0.0.0-PLACEHOLDER",
    "@daffodil/core": "0.0.0-PLACEHOLDER",
    "@daffodil/geography": "0.0.0-PLACEHOLDER",
    "@daffodil/design": "0.0.0-PLACEHOLDER"
  },
  "devDependencies": {
    "@daffodil/core": "0.0.0-PLACEHOLDER",
    "@daffodil/geography": "0.0.0-PLACEHOLDER",
    "@daffodil/design": "0.0.0-PLACEHOLDER"
  }
}
